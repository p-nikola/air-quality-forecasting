FROM python:3.10-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends default-jdk-headless libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/.cache/huggingface
ENV TRANSFORMERS_CACHE=/app/.cache/huggingface

RUN pip install --no-cache-dir --compile \
    pandas \
    numpy \
    findspark \
    pyspark==3.5.7 \
    kafka-python \
    autogluon.timeseries==1.5.0

COPY . .

CMD ["python", "app/bitola/main_program.py"]
